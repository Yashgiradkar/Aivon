{
	"name": "Aivon-monorepo",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"test": "tsx eval/tests/securityAndGuardrails.test.ts && tsx eval/tests/contextAndRouting.test.ts",
		"eval": "tsx eval/runEval.ts",
