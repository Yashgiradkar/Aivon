{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [ "./*" ],
      "@workspace/ui/*": [ "../../packages/ui/src/*" ],
      "@workspace/backend/*": [ "../../packages/backend/convex/*" ],
      "@convex-dev/agent-playground": [ "../../packages/backend/convex/types/agent-playground.d.ts" ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [ "node_modules" ]
}